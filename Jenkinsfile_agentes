pipeline {
    agent any

    stages {
        stage('GetCode') {
            steps {
                sh 'whoami'
                sh 'hostname'
                echo "Workspace directory is: ${WORKSPACE}"
                echo 'Getting code'
                git branch: 'master', url: 'https://github.com/devrtenesaca/todo-list-aws.git'
                stash name: 'source-code', includes: '**'
            }
        }
        
        
        stage('Build') {
            steps {
                sh 'whoami'
                sh 'hostname'
                script {
                    echo "stage:  build infraestructura"
                    sh "ls -la"
                    sh "sam build"
                }
            }
        }

        stage('Deploy') {
            steps {
                sh 'whoami'
                sh 'hostname'
                echo "stage: deployando infraestructura"
                    sh """
                    sam deploy \
                        --config-env production \
                        --resolve-s3 \
                        --no-confirm-changeset \
                        --no-fail-on-empty-changeset
                    """
            }
        }
    
       stage('Unit Testing') {
            agent { label 'agent01'}
            steps {
                sh 'whoami'
                sh 'hostname'
                echo "stage: obteniendo outputs"
                
                script {
                    unstash 'source-code'
                    def apiUrl = sh(
                        script: "aws cloudformation describe-stacks --stack-name todo-list-aws-production --query 'Stacks[0].Outputs[?OutputKey==`BaseUrlApi`].OutputValue' --region us-east-1 --output text",
                        returnStdout: true ).trim()
                    // Asignamos a una variable de entorno de Jenkins
                    env.BASE_URL = apiUrl
                    echo "La URL de la API capturada es: ${env.BASE_URL}"
                    sh """
                        python3 -m pytest -v \
                        test/integration/todoApiTest.py::TestApi::test_api_listtodos \
                        test/integration/todoApiTest.py::TestApi::test_api_gettodo \
                        --junitxml=result-api.xml
                    """
                }
            }
        }  
        

        stage ('Results'){
            agent { label 'agent01'}
            steps {
                sh 'whoami'
                sh 'hostname'
                echo "stage: visualizando resultados"
                junit 'result*.xml'
            }
        }
        
        
    
    }
}
